Bootstrap: docker
From: rocker/verse:4.6.2

%post

# Install btop etc
    apt-get update -y
    apt-get install -y btop tmux libmagick++-dev
    apt-get clean
    rm -rf /var/lib/apt/lists/*   

# Define date for CRAN snapshot (to ensure reproducible R package versions)
    WHEN='2026-11-25'

# Install pak first
    R -e "install.packages('pak', repos = 'https://packagemanager.posit.co/cran/__linux__/noble/${WHEN}/')"

# Then, all other packages

    R -e "

    pak::repo_add(CRAN = 'RSPM@${WHEN}')

    pkgs <- c(
        # Data IO
        'data.table', 'DBI', 'duckdb@2.0.0', 'arrow', 'fst', 'haven', 'iotools', 'here', 'anotherSAS7bdat',

        # Parallel processing
        'futureverse', 'parallelly', 'furrr', 'targets', 'tarchetypes', 'crew', 'mirai',

        # String handling
        'stringi', 'stringfish', 'fuzzystring', 'stringdist',

        # Computing
        'collapse', 'kit', 'matrixStats', 'fastmatch', 'Rfast', 'Rfast2',

        # Plotting
        'tinyplot', 'ggplot2', 'gridExtra', 'gridGraphics', 'grImport2', 'gridSVG', 'ggeffects',
        'ggplotify', 'ggridges', 'ggforce', 'ggside', 'ggsurvfit', 'ggstats', 'ggrepel',
        'ggh4x', 'ggtext', 'ggnewscale', 'DiagrammeR', 'lemon', 'patchwork', 'dagitty', 'ggdag',
        'ragg', 'svglite', 'systemfonts', 'textshaping', 'ggraph', 'gganimate', 'magick', 'terminalgraphics',
        'vtree', 'ggalign',

        # Tables
        'gtsummary', 'gt', 'gtExtras', 'DT', 'reactable', 'xtable', 'huxtable', 'flextable',

        # Epi tools
        'Epi', 'popEpi', 'epiR',

        # Models
        'lme4', 'glmmTMB', 'gamm4', 'msm', 
        'fixest', 'lmerTest', 'lmtest', 'sandwich', 'pbkrtest', 'emmeans', 'marginaleffects',
        'easystats', 'butcher', 'metagam', 'flexsurv',  'sensemakr',

        # Imputation
        'mice', 'miceadds', 'mitml', 'missRanger', 'mixgb', 

        # Causal inference
        'WeightIt', 'MatchIt', 'tmle', 'ltmle', 'drtmle', 'clubSandwich', 'SuperLearner', 'rbounds',
        'EValue', 'cobalt', 'survey', 'grf', 'DoubleML',

        # ML/AI
        'ellmer', 'ranger', 'xgboost',

        # Reports
        'rmarkdown', 'knitr', 'flexdashboard', 'officer'
    )

    pak::pkg_install(pkgs)

    "

# Add duckDB extensions for handling SAS files (among others)

    export DUCKDB_R_HOME=/opt/duckdb
    mkdir -p /opt/duckdb
    R -e "con <- DBI::dbConnect(duckdb::duckdb()); DBI::dbExecute(con, 'INSTALL read_prs FROM community'); DBI::dbExecute(con, 'LOAD read_prs')"
    ls -R /opt/duckdb
    chmod -R a+rX /opt/duckdb

%environment
    export DUCKDB_R_HOME=/opt/duckdb

%test
    Rscript -e "con <- DBI::dbConnect(duckdb::duckdb()); DBI::dbExecute(con, 'LOAD read_prs'); print(DBI::dbGetQuery(con, \"SELECT extension_name, install_path FROM duckdb_extensions() WHERE extension_name = 'read_prs'\"))"
